# Copy to `.env.local` and fill in. Nothing here is secret: every VITE_* value is
# inlined into the JavaScript bundle and readable by anyone who visits the site.
# That is fine for Firebase web config, which is designed to be public — access
# is controlled by Firestore Security Rules, not by hiding these values.
#
# Never put a service-account key or Firebase Admin credential in this file.
# Those bypass security rules completely and must stay out of the frontend.

# ---------------------------------------------------------------------------
# Firebase (Project settings -> General -> Your apps -> Web app -> SDK setup)
# ---------------------------------------------------------------------------
# Leave these blank to run against the built-in mock backend with seed data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Analytics measurement ID. Not read yet: src/utils/analytics.ts logs to
# the console and exposes `registerAnalyticsSink` for a Firebase sink to attach.
VITE_FIREBASE_MEASUREMENT_ID=

# Force the mock backend even when the values above are present. Useful for
# demos and for working on the UI without touching production data.
VITE_USE_MOCK_DATA=false

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
# Base path the site is served from.
#   "/"        -> <owner>.github.io or a custom domain
#   "my-repo"  -> <owner>.github.io/my-repo/
# CI derives this automatically; set it only to override.
VITE_BASE_PATH=/

# "browser" (default) needs the 404.html fallback the deploy workflow creates.
# "hash" produces /#/alumni URLs that work anywhere with no server support.
VITE_ROUTER_MODE=browser

# ---------------------------------------------------------------------------
# School branding — every value has a sensible default in src/config/school.ts
# ---------------------------------------------------------------------------
VITE_SCHOOL_NAME=St. John's School
VITE_SCHOOL_SHORT_NAME=St. John's
VITE_SCHOOL_LOGO=
VITE_SCHOOL_PRIMARY_COLOR=#0f4c5c
VITE_SCHOOL_SECONDARY_COLOR=#9a3412
VITE_SCHOOL_ACCENT_COLOR=#f4d58d
VITE_SCHOOL_FOUNDED_YEAR=1956
VITE_SCHOOL_LOCATION=Kerala, India
VITE_SCHOOL_TAGLINE=Reconnect. Remember. Give Back.
VITE_SCHOOL_CONTACT_EMAIL=alumni@example.org
VITE_SCHOOL_FACEBOOK_URL=
VITE_SCHOOL_HERO_IMAGE=

# ---------------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------------
# Log tracked events to the console. On automatically in development.
VITE_ANALYTICS_DEBUG=false
